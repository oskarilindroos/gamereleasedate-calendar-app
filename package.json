{
  "name": "game-release-calendar",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:mock": "EXPO_PUBLIC_IGDB_API_URL=http://localhost:4000/v4 EXPO_PUBLIC_TWITCH_TOKEN_URL=http://localhost:4000/oauth2/token EXPO_PUBLIC_IGDB_IMAGE_URL=http://localhost:4000/images EXPO_PUBLIC_IGDB_CLIENT_ID=mock-client-id EXPO_PUBLIC_IGDB_CLIENT_SECRET=mock-client-secret expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "mock-api": "node mock-igdb/server.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "e2e": "maestro test --platform ios .maestro"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/drawer": "^7.14.4",
    "@react-navigation/native": "^7.5.1",
    "date-fns": "^4.4.0",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-calendar": "~58.0.6",
    "expo-dev-client": "~58.0.15",
    "expo-font": "~58.0.10",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "test-renderer": "~1.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.tsx"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.maestro/"
    ]
  },
  "engines": {
    "node": ">=22.18"
  }
}

# Copy to .env and fill in your Twitch/IGDB app credentials:
# https://api-docs.igdb.com/#account-creation
#
# NOTE: EXPO_PUBLIC_* values are embedded in the app bundle. Fine for a personal
# build, but don't publish an app containing your client secret (use a small
# backend proxy for that instead).
EXPO_PUBLIC_IGDB_CLIENT_ID=
EXPO_PUBLIC_IGDB_CLIENT_SECRET=

# Optional overrides (defaults shown)
# EXPO_PUBLIC_IGDB_API_URL=https://api.igdb.com/v4
# EXPO_PUBLIC_TWITCH_TOKEN_URL=https://id.twitch.tv/oauth2/token
# EXPO_PUBLIC_IGDB_IMAGE_URL=https://images.igdb.com/igdb/image/upload
